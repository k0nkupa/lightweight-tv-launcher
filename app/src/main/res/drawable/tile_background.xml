<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="@color/tile_pressed" /><stroke android:width="3dp" android:color="@color/focus" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/tile_focused" /><stroke android:width="3dp" android:color="@color/focus" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape><gradient android:startColor="#303237" android:endColor="@color/tile" android:angle="270" /><stroke android:width="1dp" android:color="@color/border" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
